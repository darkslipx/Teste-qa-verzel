# 08 Protocolo

### API-51 | JSON malformado
# Esperado: 400 JSON_INVALIDO
POST {{baseUrl}}/api/carrinho/calcular
Content-Type: application/json

{"itens": [ {"produtoId": "P001", 

### API-52 | Corpo e uma lista
# Esperado: 400 JSON_INVALIDO (nao e objeto)
POST {{baseUrl}}/api/carrinho/calcular
Content-Type: application/json

[1,2,3]

### API-53 | GET no calcular
# Esperado: 405 METODO_NAO_PERMITIDO
GET {{baseUrl}}/api/carrinho/calcular

### API-54 | DELETE em produtos
# Esperado: 405 METODO_NAO_PERMITIDO
DELETE {{baseUrl}}/api/produtos

### API-55 | Rota inexistente
# Esperado: 404 ROTA_NAO_ENCONTRADA
GET {{baseUrl}}/api/cupons

# 09 Rodada complementar

### API-56 | Pedido com cupom minusculo e espacos (CA02)
# Esperado: 201; cupom aplicado, desconto 5.99
POST {{baseUrl}}/api/pedidos
Content-Type: application/json

{
  "cliente": { "nome": "Maria Silva", "email": "maria@exemplo.com", "cep": "01310-100" },
  "itens": [ { "produtoId": "P001", "quantidade": 1 } ],
  "cupom": "  bemvindo10  "
}

### API-57 | Pedido com produto inexistente
# Esperado: 422 PRODUTO_NAO_ENCONTRADO, campo itens[0].produtoId
POST {{baseUrl}}/api/pedidos
Content-Type: application/json

{
  "cliente": { "nome": "Maria Silva", "email": "maria@exemplo.com", "cep": "01310-100" },
  "itens": [ { "produtoId": "P999", "quantidade": 1 } ]
}

### API-58 | Pedido com item duplicado
# Esperado: 422 ITEM_DUPLICADO
POST {{baseUrl}}/api/pedidos
Content-Type: application/json

{
  "cliente": { "nome": "Maria Silva", "email": "maria@exemplo.com", "cep": "01310-100" },
  "itens": [ { "produtoId": "P001", "quantidade": 1 }, { "produtoId": "P001", "quantidade": 1 } ]
}

