# Verzel Store: testes manuais da API
# Extensão: REST Client (VS Code). Clique em "Send Request" acima de cada requisição.
# O resultado esperado está no comentário de cada uma.

@baseUrl = https://verzel-store.qa-test-verzel-store.workers.dev


# 01 Produtos

### API-01 | GET lista de produtos
# Esperado: 200 com 8 produtos
GET {{baseUrl}}/api/produtos

### API-02 | GET produto P001
# Esperado: 200 com Camiseta Essencial, preco 59.9
GET {{baseUrl}}/api/produtos/P001

### API-03 | GET produto inexistente P999
# Esperado: 404 PRODUTO_NAO_ENCONTRADO
GET {{baseUrl}}/api/produtos/P999


# 02 Calculo

### API-04 | Exemplo da documentacao
# Esperado: 200; subtotal 239.7, desconto 23.97, frete 0, total 215.73
POST {{baseUrl}}/api/carrinho/calcular
Content-Type: application/json

{
  "itens": [
    {
      "produtoId": "P002",
      "quantidade": 1
    },
    {
      "produtoId": "P004",
      "quantidade": 2
    }
  ],
  "cupom": "BEMVINDO10"
}

